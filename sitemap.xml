---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for page in site.pages %}
    {%- if page.sitemap == false or page.noindex or page.url contains ".json" or page.url contains ".txt" or page.url contains ".xml" or page.url contains "/assets/" %}{% continue %}{% endif %}
  <url><loc>{{ page.url | replace: "index.html", "" | absolute_url }}</loc></url>
  {%- endfor %}
</urlset>
